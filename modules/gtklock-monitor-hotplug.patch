+// The compositor decides which lock surface gets the keyboard, and each window
+// has its own password field that only takes keys while its form is shown. Move
+// the form to whichever window the keyboard enters, so typing always reaches a
+// visible field (the compositor may pick another monitor than gtklock did, e.g.
+// after a hotplug).
+static gboolean window_focus_in(GtkWidget *widget, GdkEvent *event, gpointer data) {
+	struct Window *win = window_by_widget(widget);
+	if(win != NULL && win != gtklock->focused_window) gtklock_focus_window(gtklock, win);
+	return FALSE;
+}
