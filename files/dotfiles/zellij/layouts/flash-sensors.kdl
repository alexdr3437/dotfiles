layout {
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar";
    }
    children;
    pane size=2 borderless=true {
      plugin location="zellij:status-bar";
    }
  }

  tab name="runners" {
    pane command="bash" {
      args "-lc" "sleep $(shuf -i 0-3000 -n 1 | awk '{printf \"%.3f\", $1/1000}'); tools/runner.sh --hw-reset -s P00031 output/sensor/merged.hex -p tools/mmpb.cfg -i 5 --rtt --recover";
    }
  }
}
